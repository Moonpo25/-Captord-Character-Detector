    <!-- Settings: privacy dialog -->
    <string name="settings_privacy_dialog_title">Privacy Policy</string>
    <string name="settings_privacy_dialog_body">Captord processes screen capture and audio locally on this device. Recordings are not uploaded, and the MVP includes no external analytics or trackers. Screen capture requires MediaProjection consent; microphone and internal audio require the applicable Android permissions and source-app support. Overlay access is used only for optional recording controls. Recordings remain in the selected local folder until you delete them.\n\nYour screen and audio content belong purely to you.</string>
